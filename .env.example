# Required at runtime
DATABASE_URL=postgres://postgres:apex@localhost:5433/postgres
PORT=8080

# Sui fullnode JSON-RPC (defaults to testnet if unset)
SUI_JSONRPC_URL=https://fullnode.testnet.sui.io:443

# Chain config — all optional. Indexer runs only if APEX_PACKAGE_ID is set.
# Keeper runs only if all four below are set.
APEX_PACKAGE_ID=
POOL_CONFIG_ID=
KEEPER_CAP_ID=
SUI_KEEPER_KEY=

# Logging
RUST_LOG=apex_backend=debug,tower_http=info
